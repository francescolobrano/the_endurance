esac

# ---- main window ----
# downloaded apps carry a "quarantine" flag that can block the bundled Python: remove it (best effort)
( APPDIR="$(cd "$DIR/../.." && pwd)"; xattr -dr com.apple.quarantine "$APPDIR" 2>/dev/null ) &
# quitting the app (Cmd+Q, Close, Dock quit) also stops the monitor, the OSC monitor and autosave.
# If a newer window is already open (the app was opened again) the monitor is left alone.
cleanup() {
  trap - EXIT TERM HUP INT
  if [ -n "$WPID" ]; then kill "$WPID" 2>/dev/null; sleep 0.3; kill -9 "$WPID" 2>/dev/null; fi
  if ! pgrep -f "[e]ndurance_window\.js" >/dev/null 2>&1; then
    osc_post disable >/dev/null 2>&1
    stop_it >/dev/null 2>&1
  fi
  exit 0
}
trap cleanup EXIT TERM HUP INT
# always start OFF: stop a monitor left running from before (this also switches the OSC monitor and autosave off)
if running; then osc_post disable >/dev/null 2>&1; stop_it; fi
# one window only: close a stale copy left over from an earlier launch
pkill -f "[e]ndurance_window\.js" 2>/dev/null; pkill -f "[d]ummy_plug_window\.js" 2>/dev/null; sleep 0.5
mkdir -p "$UI_DIR" && rm -f "$UI_DIR"/*.json "$UI_DIR"/*.tmp 2>/dev/null
T0=$(date +%s)
rm -f "$UI_DIR/quit" "$UI_DIR/alive"
# the window runs as a child process; when this launcher ends for any reason (Cmd+Q, Dock quit, signal) the child is ended too
WPID=""
run_win() {
  LIBFFI_TMPDIR="$UI_DIR" osascript -l JavaScript "$DIR/endurance_window.js" "$ICON" "$0" "$DIR/window.html" "$UI_DIR" "$1" >"$UI_DIR/window.log" 2>&1 &
  WPID=$!
  wait $WPID
  RC=$?
  WPID=""
}
run_win ""
# the window counts as opened if it reached the run loop; quitting right away (Cmd+Q) is then normal
if ! grep -q "entering run loop" "$UI_DIR/window.log" 2>/dev/null; then
  # one more try in safe mode (without the app-name change)
  run_win safe
  if ! grep -q "entering run loop" "$UI_DIR/window.log" 2>/dev/null; then
    WINERR="$(head -c 700 "$UI_DIR/window.log" 2>/dev/null | tr -d '\r')"
    fb_info "The graphic window could not open, using the simple version."$'\n\n'"Error (please send it to the developer):"$'\n'"macOS $(sw_vers -productVersion 2>/dev/null) - $WINERR"
    fallback_loop
  fi
fi
exit 0
